// Global balance values (ADR 0003). Initial values are spec v3 §9.1,
// validated by the combat-feel prototype.
(
    player: (
        move_speed: 110.0,          // px/s
        snappiness: 25.0,           // exponential approach rate toward the target velocity, 1/s
        max_hp: 100.0,
        hurt_invulnerability: 0.6,  // s after a hit
        radius: 5.0,                // collision circle at the feet, px
        starting_weapon: "laspistol", // id in weapons.ron
        dodge_roll: (               // timings in s from the start of the roll
            speed: 260.0,           // px/s
            duration: 0.25,
            invincibility: 0.30,
            cooldown: 0.8,
        ),
        resistances: {},            // damage type: fraction ignored, e.g. { Energy: 0.25 }
    ),
    room: (
        interior_width: 464.0,      // px
        interior_height: 224.0,     // px
        wall_thickness: 8.0,        // px
    ),
    floor: (
        min_rooms: 8,
        max_rooms: 12,
        grid_width: 9,              // Rooms
        grid_height: 8,             // Rooms
        expansion_chance: 0.5,      // per Room, per direction
        encounter_rooms: 1,
    ),
    combat: (
        max_resistance: 0.75,       // no Resistance ignores more than this fraction of a hit
    ),
    spawns: (
        min_distance: 100.0,        // px from the player
        wave_enemy: "cultist_rusher", // id in enemies.ron
        wave_size: 4,               // the Run's opening wave, until Rooms have their own fights
    ),
    juice: (
        shake_on_hit: 1.0,          // px
        shake_on_kill: 3.0,
        shake_on_hurt: 6.0,
        shake_decay: 40.0,          // px/s
        freeze_on_kill: 0.040,      // s
        freeze_on_hurt: 0.080,
        hit_flash: 0.08,            // s an enemy flashes white when hit
        hurt_flash: 0.12,           // s the player flashes white when hurt
        knockback: 60.0,            // px/s added to a hit enemy along the shot
        knockback_decay: 10.0,      // 1/s
    ),
    max_frame_delta: 0.05,          // s; longer frames are clamped so nothing tunnels
)
